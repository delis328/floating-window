<Window x:Class="FloatingTxtReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TXT Floating Reader"
        Icon="/FloatingTxtReader;component/Assets/FloatingTxtReader.ico"
        Width="420" Height="56"
        MinWidth="80" MinHeight="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseMove="Window_MouseMove"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragHandleHitArea"
              Grid.Row="0"
              Width="48"
              Height="18"
              HorizontalAlignment="Center"
              Background="#01000000"
              Cursor="SizeAll"
              ToolTip="&#x62D6;&#x52A8;&#x7A97;&#x53E3;"
              MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <Ellipse Width="11"
                     Height="11"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#B8FFFFFF"
                     Stroke="#E6FFFFFF"
                     StrokeThickness="1" />
        </Grid>
        <Border x:Name="Surface"
                Grid.Row="1"
                Background="#01000000"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="3"
                Padding="6,4">
            <TextBlock x:Name="ReaderText"
                       TextWrapping="NoWrap"
                       TextTrimming="None"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
