<Window x:Class="FloatingTxtReader.BlankLinePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="去除空行" Width="500" SizeToContent="Height">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="SettingsDialog" /></Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="FileNameText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource DialogMuted}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="处理前 · 节选" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Column="2" Text="处理后 · 节选" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Grid.Row="1" Height="162" CornerRadius="8" Padding="8" Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource FieldOutline}" BorderThickness="1">
                        <TextBlock x:Name="BeforeText" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Path Grid.Row="1" Grid.Column="1" Width="16" Height="14" Data="M 0,7 L 15,7 M 9,1 L 15,7 L 9,13"
                          Stroke="{StaticResource DialogOutline}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="2" Height="162" CornerRadius="8" Padding="8" Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource FieldOutline}" BorderThickness="1">
                        <TextBlock x:Name="AfterText" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
                <TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource DialogMuted}" />
                <TextBlock Text="只影响阅读显示，不修改原 TXT；切换文件后重新询问。" Margin="0,4,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource DialogMuted}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="KeepButton" Width="92" Margin="0,0,6,0" IsCancel="True" IsDefault="True" Click="Keep_Click">保留原样</Button>
            <Button x:Name="RemoveButton" Width="92" Style="{StaticResource ApplyButton}" Click="Remove_Click">去除空行</Button>
        </StackPanel>
    </Grid>
</Window>
