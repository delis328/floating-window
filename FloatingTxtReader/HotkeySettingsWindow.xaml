<Window x:Class="FloatingTxtReader.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="SettingsDialog" /></Window.Style>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Foreground="{StaticResource DialogMuted}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="点击录入快捷键，“清空”取消绑定。&#x0A;设置期间暂停全局快捷键，关闭后恢复。" />
                <StackPanel x:Name="BindingsPanel" />
                <Border Height="1" Background="#C7D4CB" Margin="0,4,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="快进速度（行 / 秒）" VerticalAlignment="Center" />
                    <TextBox x:Name="FastForwardSpeedBox" Grid.Column="1" />
                    <TextBlock x:Name="SpeedRangeText" Grid.Column="2" Margin="8,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource DialogMuted}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="按住快进行保持匀速，松开立即停止。" Margin="0,6,0,0" Foreground="{StaticResource DialogMuted}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F7EAE7" CornerRadius="8" Padding="8" Margin="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="ErrorText" Foreground="#923E35" TextWrapping="Wrap" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Width="64" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click">取消</Button>
            <Button x:Name="ApplyButton" Width="64" Style="{StaticResource ApplyButton}" Click="Apply_Click">应用</Button>
        </StackPanel>
    </Grid>
</Window>
