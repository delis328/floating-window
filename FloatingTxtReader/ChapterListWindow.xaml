<Window x:Class="FloatingTxtReader.ChapterListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x7AE0;&#x8282;&#x5217;&#x8868;" Width="380" Height="520"
        MinWidth="260" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,8" MaxLines="1"
                 ToolTip="&#x8F93;&#x5165;&#x5173;&#x952E;&#x5B57;&#x7B5B;&#x9009;&#x7AE0;&#x8282;"
                 TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown" />

        <ListBox x:Name="ChapterList" Grid.Row="1"
                 VirtualizingPanel.IsVirtualizing="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ChapterList_MouseDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,12,8,0" Click="Cancel_Click">&#x53D6;&#x6D88;</Button>
            <Button Width="80" Margin="0,12,0,0" IsDefault="True" Click="Jump_Click">&#x8DF3;&#x8F6C;</Button>
        </StackPanel>
    </Grid>
</Window>
