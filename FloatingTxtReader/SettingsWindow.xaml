<Window x:Class="FloatingTxtReader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x9605;&#x8BFB;&#x8BBE;&#x7F6E;" Width="410" Height="570"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="&#x6BCF;&#x6B21;&#x663E;&#x793A;&#x884C;&#x6570;" />
        <TextBox x:Name="VisibleLinesBox" Grid.Row="0" Grid.Column="1" />
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="&#x6BCF;&#x884C;&#x6700;&#x5927;&#x5B57;&#x7B26;" />
        <TextBox x:Name="CharactersPerLineBox" Grid.Row="1" Grid.Column="1" />
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="&#x5B57;&#x4F53;" />
        <TextBox x:Name="FontFamilyBox" Grid.Row="2" Grid.Column="1" />
        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="&#x5B57;&#x53F7;" />
        <TextBox x:Name="FontSizeBox" Grid.Row="3" Grid.Column="1" />
        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="&#x5B57;&#x91CD;" />
        <ComboBox x:Name="FontWeightBox" Grid.Row="4" Grid.Column="1" SelectedIndex="0">
            <ComboBoxItem Content="&#x5E38;&#x89C4;" />
            <ComboBoxItem Content="&#x52A0;&#x7C97;" />
        </ComboBox>
        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="&#x5B57;&#x5F62;" />
        <ComboBox x:Name="FontStyleBox" Grid.Row="5" Grid.Column="1" SelectedIndex="0">
            <ComboBoxItem Content="&#x5E38;&#x89C4;" />
            <ComboBoxItem Content="&#x659C;&#x4F53;" />
        </ComboBox>
        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="&#x6587;&#x5B57;&#x989C;&#x8272;" />
        <ComboBox x:Name="ColorBox" Grid.Row="6" Grid.Column="1" SelectedIndex="0">
            <ComboBoxItem Content="&#x767D;&#x8272;" />
            <ComboBoxItem Content="&#x9ED1;&#x8272;" />
        </ComboBox>
        <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="&#x6587;&#x5B57;&#x4E0D;&#x900F;&#x660E;&#x5EA6; (0-1)" />
        <TextBox x:Name="TextOpacityBox" Grid.Row="7" Grid.Column="1" />
        <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="&#x884C;&#x9AD8;&#x500D;&#x7387;" />
        <TextBox x:Name="LineHeightBox" Grid.Row="8" Grid.Column="1" />
        <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="&#x5168;&#x5C40;&#x5173;&#x95ED;&#x5FEB;&#x6377;&#x952E;" />
        <TextBox x:Name="HotkeyBox" Grid.Row="9" Grid.Column="1" IsReadOnly="True"
                 ToolTip="&#x70B9;&#x51FB;&#x540E;&#x6309;&#x4E0B;&#x5FEB;&#x6377;&#x952E;" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
        <TextBlock x:Name="ErrorText" Grid.Row="10" Grid.ColumnSpan="2" Foreground="Firebrick" TextWrapping="Wrap" />
        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,12,8,0" Click="Cancel_Click">&#x53D6;&#x6D88;</Button>
            <Button Width="80" Margin="0,12,0,0" IsDefault="True" Click="Apply_Click">&#x5E94;&#x7528;</Button>
        </StackPanel>
    </Grid>
</Window>
