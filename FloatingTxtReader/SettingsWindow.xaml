<Window x:Class="FloatingTxtReader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="阅读设置" Width="340" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="SettingsDialog" /></Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="文本显示" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="每次显示行数" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="VisibleLinesBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="每行最大字符" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CharactersPerLineBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="2" Text="行高倍率" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LineHeightBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
                </Grid>
                <Border Height="1" Background="#C7D4CB" Margin="0,4,0,10" />
                <TextBlock Text="文字样式" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="字体" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FontFamilyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="字号" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="2" Text="字重" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FontWeightBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                        <ComboBoxItem Content="常规" /><ComboBoxItem Content="加粗" />
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="字形" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FontStyleBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                        <ComboBoxItem Content="常规" /><ComboBoxItem Content="斜体" />
                    </ComboBox>
                    <TextBlock Grid.Row="4" Text="文字颜色" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ColorBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                        <ComboBoxItem Content="白色" /><ComboBoxItem Content="黑色" />
                    </ComboBox>
                    <TextBlock Grid.Row="5" Text="不透明度（0.1–1）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextOpacityBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F7EAE7" CornerRadius="8" Padding="8" Margin="0,4,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="ErrorText" Foreground="#923E35" TextWrapping="Wrap" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Width="64" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click">取消</Button>
            <Button x:Name="ApplyButton" Width="64" IsDefault="True" Style="{StaticResource ApplyButton}" Click="Apply_Click">应用</Button>
        </StackPanel>
    </Grid>
</Window>
